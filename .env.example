# NIVAAN — environment variables (Phase 0)
# Source of truth: docs/roadmap.md "Environment variables & external services".
# Copy to .env.local and fill in — NEVER commit real values.
# Per docs/security-model.md: every *_KEY / *_SECRET / *_SEED / SESSION_SECRET lives
# only here (locally) or in Vercel's encrypted env storage — never in source, never logged.
# All keys are TESTNET-ONLY for the MVP. Before demo day, grep for any mainnet RPC/funded key.

# --- Midnight (credential issuance + proof generation) ---
MIDNIGHT_TESTNET_RPC=
MIDNIGHT_WALLET_SEED=
PROOF_SERVER_URL=

# --- Anon Aadhaar (Test QR generator — ADR-003) ---
ANON_AADHAAR_TEST_KEY=

# --- Soroban / Stellar testnet ---
SOROBAN_RPC_URL=
SOROBAN_TESTNET_SECRET=

# --- Sepolia / EVM testnet ---
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_KEY=

# --- Backend trust root (ADR-001) — HIGHEST-PRIORITY SECRET (docs/security-model.md) ---
# If this leaks, an attacker can forge "verified" results on both registry contracts. Rotate on any exposure.
BACKEND_ATTESTATION_SIGNING_KEY=

# --- Issuer + demo verifier ---
ISSUER_ADMIN_KEY=
DEMO_VERIFIER_KEY=

# --- Database (Postgres via Supabase/Neon for hosted; SQLite ok for local dev — ADR-006) ---
DATABASE_URL=

# --- Session (wallet-signature auth — ADR-004) ---
SESSION_SECRET=
